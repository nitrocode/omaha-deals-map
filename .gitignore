# Personal data, kept out of the public repo.
data/overrides/personal.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local env (1Password, API keys)
.env
.env.local

# Pipeline transient outputs are committed (data/parsed.yaml, data/extracted.yaml,
# data/geocoded.yaml, data/deals.json, caches). Only the personal override is excluded.
*.egg-info/

# Raw per-source snapshots (binary pickles, regenerate via `make scrape`)
data/raw/

# Coverage artifacts (regenerated by pytest --cov)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local browser-automation captures (one-off debugging artifacts).
.playwright-mcp/

# Skill workspaces and per-skill eval runs are personal, not repo content.
.claude/skills/*-workspace/
.claude/skills/*/evals/
